<#- Jinja2 template rendered by pipeline/core/render.py.
    Delimiters (chosen to not clash with LaTeX): double-angle for variables,
    angle-percent for blocks, angle-hash for comments. See render.py.
    All free text goes through the `tex` filter (escaping + **bold** + [link](url)). -#>
% GENERATED FILE: do not edit by hand.
% Source: << source_path >>
\documentclass{resume}
\hypersetup{
  pdftitle={<< profile.name >> - << t.resume >>},
  pdfauthor={<< profile.name >>},
  pdfcreator={<< profile.name >>},
}

\begin{document}

<% include "_header.tex.j2" %>

\vspace{5 pt - 0.3 cm}
<% for section in sections %>
<% if section == "summary" and summary %>

\section{<< t.summary >>}
\begin{onecolentry}
<< summary | tex >>
\end{onecolentry}
<% elif section == "skills" and (skills or languages) %>

\section{<< t.skills >>}
<% for cat in skills %>
\begin{onecolentry}
\textbf{<< cat.label | tex >>:} << cat["items"] | map("tex") | join(", ") >>
\end{onecolentry}
<% endfor %>
<% if languages %>
\begin{onecolentry}
\textbf{<< t.languages >>:} << languages | map("tex") | join(", ") >>
\end{onecolentry}
<% endif %>
<% elif section == "experience" and experiences %>

\section{<< t.experience >>}
<% for e in experiences %>

\begin{twocolentry}{<< e.dates | tex >>}
\textbf{<< e.title | tex >>}, << e.company | tex >> -- << e.location | tex >>\end{twocolentry}
<% if e.bullets or e.stack %>
\vspace{0.10 cm}
\begin{onecolentry}
  \begin{highlights}
<% for b in e.bullets %>
    \item << b | tex >>
<% endfor %>
<% if e.stack %>
    \begin{highlightsforbulletentries}
    \item << t.stack >>: << e.stack | map("tex") | join(", ") >>
    \end{highlightsforbulletentries}
<% endif %>
  \end{highlights}
\end{onecolentry}
<% endif %>
<% if not loop.last %>
\entryspace
<% endif %>
<% endfor %>
<% elif section == "projects" and projects %>

\section{<< t.projects >>}
<% for p in projects %>
\begin{onecolentry}
  \begin{highlights}
<# one bullet: inline after the name; several: nested under it, like the stack line #>
<% set nested = p.bullets | length > 1 %>
    \item \textbf{<% if p.url %>\href{<< p.url | url >>}{<< p.name | tex >>:}<% else %><< p.name | tex >>:<% endif %>}<% if not nested %> << p.bullets | map("tex") | join(" ") >><% endif %>
<% if nested or p.stack %>
    \begin{highlightsforbulletentries}
<% if nested %>
<% for b in p.bullets %>
    \item << b | tex >>
<% endfor %>
<% endif %>
<% if p.stack %>
    \item << t.stack >>: << p.stack | map("tex") | join(", ") >>
<% endif %>
    \end{highlightsforbulletentries}
<% endif %>
  \end{highlights}
\end{onecolentry}
<% if not loop.last %>
\vspace{0.1 cm}
<% endif %>
<% endfor %>
<% elif section == "education" and education %>

\section{<< t.education >>}
<% for s in education %>
\begin{twocolentry}{<< s.dates | tex >>}
\textbf{<< s.degree | tex >>}, << s.school | tex >>\end{twocolentry}
<% if s.bullets %>
\begin{onecolentry}
  \begin{highlights}
<% for b in s.bullets %>
    \item << b | tex >>
<% endfor %>
  \end{highlights}
\end{onecolentry}
<% endif %>
<% if not loop.last %>
\vspace{0.10 cm}
<% endif %>
<% endfor %>
<% endif %>
<% endfor %>

\end{document}
